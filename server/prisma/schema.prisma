// Datasource uses SQLite now; to switch to PostgreSQL update prisma.config.ts.
datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

enum ReservationStatus {
  RESERVED
  COMPLETED
  CANCELED
}

enum AircraftStatus {
  READY
  MAINTENANCE
  NOT_AVAILABLE
}

enum ActivityType {
  INSTRUCTION
  OTHER
  NOT_AVAILABLE
}

enum RoleName {
  STUDENT
  GUEST
  INSTRUCTOR
  STAFF
  ADMIN
  OTHER
}

model User {
  id            Int         @id @default(autoincrement())
  first_name    String
  last_name     String
  email         String      @unique
  phone         String?
  date_of_birth DateTime?
  address_line1 String?
  address_line2 String?
  city          String?
  state         String?
  country       String?
  postal_code   String?
  date_created  DateTime    @default(now())
  date_updated  DateTime    @updatedAt

  login               UserLogin?
  roles               UserRole[]
  instructor_schedule InstructorSchedule[]
  reservations        Reservation[]        @relation("UserReservations")
  instructor_reservations Reservation[]    @relation("InstructorReservations")
}

model Role {
  id           Int        @id @default(autoincrement())
  name         RoleName   @unique
  date_created DateTime   @default(now())
  date_updated DateTime   @updatedAt

  user_roles   UserRole[]
}

model UserLogin {
  id           Int      @id @default(autoincrement())
  user_id      Int      @unique
  username     String   @unique
  password     String
  date_created DateTime @default(now())
  date_updated DateTime @updatedAt

  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model UserRole {
  id           Int      @id @default(autoincrement())
  user_id      Int
  role_id      Int
  date_created DateTime @default(now())
  date_updated DateTime @updatedAt

  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role         Role     @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id])
}

model Reservation {
  id            Int               @id @default(autoincrement())
  user_id       Int
  aircraft_id   Int?
  instructor_id Int?
  date_start    DateTime
  date_end      DateTime
  status        ReservationStatus @default(RESERVED)
  date_created  DateTime          @default(now())
  date_updated  DateTime          @updatedAt

  user          User              @relation("UserReservations",       fields: [user_id],       references: [id], onDelete: Restrict)
  aircraft      Aircraft?         @relation(                          fields: [aircraft_id],   references: [id], onDelete: SetNull)
  instructor    User?             @relation("InstructorReservations", fields: [instructor_id], references: [id], onDelete: SetNull)
}

model Aircraft {
  id                   Int            @id @default(autoincrement())
  tail_number          String         @unique
  serial_number        String         @unique
  make                 String
  model                String
  year_built           Int
  flight_hours         Float          @default(0)
  fuel_capacity        Float?
  weight               Float?
  status               AircraftStatus @default(READY)
  rental_rate          Float?
  next_inspection_date DateTime?
  date_created         DateTime       @default(now())
  date_updated         DateTime       @updatedAt

  reservations         Reservation[]
}

model InstructorSchedule {
  id            Int          @id @default(autoincrement())
  instructor_id Int
  date_start    DateTime
  date_end      DateTime
  activity_type ActivityType
  date_created  DateTime     @default(now())
  date_updated  DateTime     @updatedAt

  instructor    User         @relation(fields: [instructor_id], references: [id], onDelete: Cascade)
}
